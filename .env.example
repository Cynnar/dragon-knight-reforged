# Copy to .env and fill in. .env is gitignored — never commit real secrets.

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=

DEBUG=false

# Hostnames this app will be served as (comma-separated). Match your NPM proxy host.
ALLOWED_HOSTS=dk.example.com
CSRF_TRUSTED_ORIGINS=https://dk.example.com

# Database inside main_db. Host is the container name on the shared network.
DATABASE_URL=mysql://dk_user:CHANGE_ME_password@main_db:3306/dragon_knight

TIME_ZONE=America/Chicago
